# Safe single-laptop default
BYOSYNC_HOST=127.0.0.1
PORT=8787
CENSUS_BRIDGE_PORT=8011

# Required when BYOSYNC_HOST is not localhost/127.0.0.1.
# The launcher generates an ephemeral token when this is blank; set one here
# only when a deployment process manages the secret securely.
BYOSYNC_ACCESS_TOKEN=
BYOSYNC_ALLOWED_HOSTS=

# Durable local state (defaults to ./integration-data)
BYOSYNC_DATA_DIR=

# Explicit local operator identity. This is not enterprise SSO.
BYOSYNC_OPERATOR_ID=HUM-LOCAL-OPERATOR
BYOSYNC_OPERATOR_NAME=Local security operator
BYOSYNC_OPERATOR_TEAM=Security
BYOSYNC_ORGANIZATION=Local organization

# Optional configured Python runtime prepared by npm run setup.
BYOSYNC_PYTHON=

# Named-user mode: provision at least one admin, builder and reviewer using
# scripts/provision-user.mjs. Use an absolute path; no credentials in browser code.
BYOSYNC_USERS_FILE=
# Public HTTPS origin when running behind a TLS reverse proxy.
BYOSYNC_PUBLIC_ORIGIN=

# Installed standalone CLIs. Leave blank to resolve from PATH.
BYOSYNC_CLAUDE_BIN=
BYOSYNC_CODEX_BIN=
BYOSYNC_CLAUDE_MODEL=
BYOSYNC_CODEX_MODEL=
# Set 0 only to disable local endpoint presence collection (e.g. cloud hosting).
BYOSYNC_ENDPOINT_DISCOVERY=1

# Optional self-hosted Mem0 server. Requires a working server plus embedding
# credentials configured on that server. Only reviewed memory is sent.
MEM0_API_URL=
MEM0_API_KEY=
# Optional Langfuse ingestion. Only run metadata and hashes are exported.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
