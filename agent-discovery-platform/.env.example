# Generate distinct role tokens locally. Never commit a populated .env.
CENSUS_ADMIN_TOKEN=
CENSUS_READER_TOKEN=
CENSUS_INGEST_TOKEN=
POSTGRES_PASSWORD=
CENSUS_DATABASE_URL=sqlite:///./census.db
# Comma-separated exact origins including port; empty denies all outbound targets.
CENSUS_ALLOWED_ORIGINS=
CENSUS_BLOCKED_HOSTS=
CENSUS_ALLOW_PRIVATE=false
CENSUS_ALLOW_HTTP=false
CENSUS_TIMEOUT_SECONDS=5
CENSUS_HEALTH_TTL_SECONDS=120
CENSUS_EVENT_WINDOW_SECONDS=3600
CENSUS_MONITOR_INTERVAL_SECONDS=30
# Optional JSON map of configured adapter names to adapter configuration lists.
CENSUS_DISCOVERY_SOURCES={}

# Optional live agent validation against Amazon Bedrock. Configure privately in .env.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
